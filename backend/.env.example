SOUL_BACKEND_SERVICE_NAME="SOUL AI Backend"
SOUL_BACKEND_VERSION=0.1.0
SOUL_BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","http://127.0.0.1:5173"]
SOUL_BACKEND_UPLOAD_DIR=uploads
SOUL_BACKEND_MAX_UPLOAD_SIZE_MB=10
SOUL_BACKEND_MAX_FILES_PER_UPLOAD=5
SOUL_BACKEND_DATABASE_URL=sqlite:///data/soul_ai.sqlite3

# AI engine provider settings (optional for document management)
SOUL_LLM_PROVIDER=openai
